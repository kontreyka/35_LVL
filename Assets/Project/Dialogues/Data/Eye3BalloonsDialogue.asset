  - speakerName: 
    text: "\u041E\u043D\u0430 \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u0430 \u0438\u0445 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0442\u044C, \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0448\u0430\u0440\u0438\u043A\u0438 \u043F\u0430\u0440\u044F\u0442 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0441\u0432\u043E\u0435\u0439 \u0441\u0443\u0434\u044C\u0431\u0435"
