  m_Script: {fileID: 11500000, guid: 2f5d49728e204b7dbf4e2cc273f1e0a9, type: 3}
  m_Name: HandGoldDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: 
    text: "\u0422\u0430\u043c, \u0437\u0430 \u043e\u043a\u043d\u043e\u043c, \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u043d\u043e\u0433\u043e \u0447\u0443\u0436\u0438\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c."
    portrait: {fileID: 0}
    centerText: 1
    fontSizeOverride: 0
  - speakerName: 
    text: "\u0427\u0435\u043c \u0434\u0430\u043b\u044c\u0448\u0435 \u0442\u044b \u043e\u0442 \u043d\u0438\u0445, \u0442\u0435\u043c \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u0435\u0435 \u0436\u0438\u0432\u0435\u0442\u0441\u044f"
    portrait: {fileID: 0}
    centerText: 1
    fontSizeOverride: 0
  - speakerName: 
    text: "\u0417\u0434\u0435\u0441\u044c \u0442\u0435\u0431\u044f \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u043e\u0431\u0438\u0434\u0438\u0442, \u043c\u0438\u043b\u043e\u0435 \u0434\u0438\u0442\u044f"
    portrait: {fileID: 0}
    centerText: 1
    fontSizeOverride: 0
  - speakerName: 
    text: "\u0420\u0430\u0437\u0432\u0435 \u0434\u043b\u044f \u0442\u0435\u0431\u044f \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c \u2014 \u044d\u0442\u043e \u043d\u0435 \u0441\u0432\u043e\u0431\u043e\u0434\u0430?"
    portrait: {fileID: 0}
    centerText: 1
    fontSizeOverride: 0
